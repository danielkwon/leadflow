# LeadFlow 공통 .env 설정 (모든 서비스 공유)

# --- 앱 ---
APP_ENV=development
LOG_LEVEL=INFO

# --- 데이터베이스 ---
DATABASE_URL=sqlite:///./data/leadflow.db

# --- 네이버 API ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Gmail (OAuth credentials JSON 파일 경로) ---
GMAIL_CREDENTIALS_PATH=config/gmail_credentials.json
GMAIL_TOKEN_PATH=config/gmail_token.json
SENDER_EMAIL=
SENDER_NAME=

# --- Google Sheets (Service Account JSON 파일 경로) ---
GOOGLE_SHEETS_CREDENTIALS_PATH=config/sheets_service_account.json
GOOGLE_SHEETS_NAME=영업_현황판

# --- AWS SES (선택사항) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION=ap-northeast-2

# --- 수신거부 ---
OPT_OUT_BASE_URL=http://localhost:8080
OPT_OUT_SECRET_KEY=change-me-to-random-secret

# --- 암호화 및 JWT (production에서는 반드시 강력한 랜덤 키로 변경) ---
# ENCRYPTION_SECRET_KEY=  # 미설정 시 OPT_OUT_SECRET_KEY 사용
# JWT_SECRET_KEY=         # 미설정 시 OPT_OUT_SECRET_KEY 사용
